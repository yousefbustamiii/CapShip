{
  "name": "capship-server",
  "version": "1.0.0",
  "private": true,
  "description": "CapShip backend — Cloudflare Workers + D1 + R2 + Polar",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run",
    "types": "wrangler types src/worker-env.d.ts",
    "db:generate": "wrangler d1 migrations list capship-db",
    "db:migrate:local": "wrangler d1 migrations apply capship-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply capship-db --remote",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.1",
    "@polar-sh/sdk": "^0.31.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.6.0",
    "resend": "^6.18.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
